{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jamesjardine2.github.io/steam-hub/cd/cd.schema.json",
  "title": "CD object",
  "description": "A curriculum fact sheet for one Victorian Curriculum 2.0 Science content description. Every field carries a status: verified (checked against a named source in `sources` that was actually read) or draft (Claude's own judgement, for James to review). See README.md in this folder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "title",
    "learning_area",
    "band",
    "strand",
    "sub_strand",
    "updated",
    "sources",
    "descriptor",
    "paraphrase",
    "key_questions",
    "vocabulary",
    "misconceptions",
    "inquiry",
    "human_endeavour",
    "related",
    "anchors",
    "pitfalls",
    "unverified"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "code": {
      "type": "string",
      "pattern": "^VC2S(F|[0-9]{1,2})U[0-9]{2}$",
      "description": "The content description code. The file name must be this code plus .json."
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "description": "A short label in our own words, for headings and links (for example Light)."
    },
    "learning_area": {
      "const": "Science"
    },
    "band": {
      "enum": [
        "Foundation to Level 2",
        "Levels 3 and 4",
        "Levels 5 and 6"
      ]
    },
    "strand": {
      "const": "Science Understanding"
    },
    "sub_strand": {
      "enum": [
        "Biological sciences",
        "Chemical sciences",
        "Earth and space sciences",
        "Physical sciences"
      ]
    },
    "updated": {
      "$ref": "#/$defs/date"
    },
    "sources": {
      "description": "Every source the fields point to. A field's `sources` list holds ids from here.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "descriptor": {
      "description": "Field 1. The official wording, copied exactly from the VCAA site, never from memory.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources",
        "stem",
        "text",
        "url",
        "attribution"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "sources": {
          "$ref": "#/$defs/sourceIds"
        },
        "note": {
          "type": "string"
        },
        "stem": {
          "type": "string",
          "description": "The lead-in the VCAA prints above the description (Students learn that:)."
        },
        "text": {
          "type": "string",
          "minLength": 10,
          "description": "The content description, word for word."
        },
        "url": {
          "type": "string",
          "pattern": "^https://f10\\.vcaa\\.vic\\.edu\\.au/"
        },
        "attribution": {
          "type": "string",
          "minLength": 10,
          "description": "The credit the VCAA licence asks for."
        }
      }
    },
    "paraphrase": {
      "description": "Field 2. What the description is really asking, in plain English for a teacher.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources",
        "text",
        "asks_for",
        "not_asking"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "sources": {
          "$ref": "#/$defs/sourceIds"
        },
        "note": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 20
        },
        "asks_for": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "The separate ideas packed into the description."
        },
        "not_asking": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What sits outside this description (often in a later level)."
        }
      }
    },
    "key_questions": {
      "description": "Field 3. Three to five questions, each with what students should Know, Understand and be able to Do.",
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "sources",
          "question",
          "know",
          "understand",
          "do"
        ],
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/sourceIds"
          },
          "note": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "know": {
            "$ref": "#/$defs/lines"
          },
          "understand": {
            "$ref": "#/$defs/lines"
          },
          "do": {
            "$ref": "#/$defs/lines"
          }
        }
      }
    },
    "vocabulary": {
      "description": "Field 4. Words in three tiers: everyday, academic (used across subjects) and science-specific.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources",
        "everyday",
        "academic",
        "science"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "sources": {
          "$ref": "#/$defs/sourceIds"
        },
        "note": {
          "type": "string"
        },
        "everyday": {
          "$ref": "#/$defs/words"
        },
        "academic": {
          "$ref": "#/$defs/words"
        },
        "science": {
          "$ref": "#/$defs/words"
        }
      }
    },
    "misconceptions": {
      "description": "Field 5. Common student ideas that differ from the science. Verified means a source in `sources` that was read documents the idea; `research` names the studies that source cites.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "sources",
          "idea",
          "science"
        ],
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/sourceIds"
          },
          "note": {
            "type": "string"
          },
          "idea": {
            "type": "string",
            "minLength": 5,
            "description": "What students think, in our own words."
          },
          "science": {
            "type": "string",
            "minLength": 5,
            "description": "The accepted idea, at this level."
          },
          "respond": {
            "type": "string",
            "description": "One way to bring the idea out or respond to it."
          },
          "research": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Studies the read source cites for this idea. Not read directly unless also listed in `sources`."
          }
        }
      }
    },
    "inquiry": {
      "description": "Field 6. Science Inquiry content descriptions at the same band that fit this description well.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "sources",
          "code",
          "skill",
          "how"
        ],
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/sourceIds"
          },
          "note": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^VC2S(F|[0-9]{1,2})I[0-9]{2}$"
          },
          "skill": {
            "type": "string",
            "description": "The sub-strand name from the VCAA site (for example Questioning and predicting)."
          },
          "how": {
            "type": "string",
            "minLength": 5,
            "description": "How the skill shows up when teaching this description."
          }
        }
      }
    },
    "human_endeavour": {
      "description": "Field 7. Science as a Human Endeavour hooks, including First Nations science perspectives where they are genuinely relevant.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "sources",
          "hook",
          "first_nations"
        ],
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/sourceIds"
          },
          "note": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^VC2S(F|[0-9]{1,2})H[0-9]{2}$"
          },
          "hook": {
            "type": "string",
            "minLength": 5
          },
          "first_nations": {
            "type": "boolean"
          }
        }
      }
    },
    "related": {
      "description": "Field 8. Related content descriptions in the levels below, at the same level and above. A row with `gap: true` records that there is nothing to link to. With `links`, the page draws the rows as a map: levels down the side, one column each for Science, Design and Technologies and Digital Technologies.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "below",
        "same",
        "above"
      ],
      "properties": {
        "below": {
          "$ref": "#/$defs/relatedList"
        },
        "same": {
          "$ref": "#/$defs/relatedList"
        },
        "above": {
          "$ref": "#/$defs/relatedList"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "description": "Optional. The lines on the map. Each joins two codes that are rows in this field (or this fact sheet's own code).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "kind"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^VC2[A-Z]{1,3}(F|[0-9]{1,2})[A-Z][0-9]{2}$"
              },
              "to": {
                "type": "string",
                "pattern": "^VC2[A-Z]{1,3}(F|[0-9]{1,2})[A-Z][0-9]{2}$"
              },
              "kind": {
                "enum": [
                  "leads",
                  "connects",
                  "loose"
                ],
                "description": "leads: `from` is built on by `to` (drawn as an arrow). connects: a strong link at the same stage, such as a STEAM pairing. loose: a weaker link (dashed)."
              }
            }
          }
        }
      }
    },
    "anchors": {
      "description": "Field 9. Two or three anchor experiences or phenomena for a 45-minute STEAM lesson in a room with no storeroom.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "sources",
          "title",
          "phenomenon",
          "students_do",
          "materials",
          "shows"
        ],
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/sourceIds"
          },
          "note": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "phenomenon": {
            "type": "string",
            "minLength": 5,
            "description": "What students see happen."
          },
          "students_do": {
            "type": "string",
            "minLength": 5
          },
          "materials": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shows": {
            "type": "string",
            "minLength": 5,
            "description": "The idea in the description it makes visible."
          },
          "caution": {
            "type": "string"
          }
        }
      }
    },
    "pitfalls": {
      "description": "Field 10. Teacher-side pitfalls when teaching this description.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "sources",
          "pitfall",
          "instead"
        ],
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/sourceIds"
          },
          "note": {
            "type": "string"
          },
          "pitfall": {
            "type": "string",
            "minLength": 5
          },
          "instead": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "unverified": {
      "description": "Anything that could not be checked, said plainly. Never guess to fill a gap: list it here. An empty list means nothing was left unchecked.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "verified",
        "draft"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "description": "A student-friendly meaning. Optional for everyday words."
          },
          "in_descriptor": {
            "type": "boolean",
            "description": "True when the word is in the official description."
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "citation",
        "read"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "citation": {
          "type": "string",
          "minLength": 10
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "accessed": {
          "$ref": "#/$defs/date"
        },
        "read": {
          "type": "boolean",
          "description": "True only when the source itself was opened and read. A study known only through another source is false."
        },
        "via": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "For a source not read: the id of the read source that cites it."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "read": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "url",
              "accessed"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "read": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "via"
            ]
          }
        }
      ]
    },
    "relatedList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "sources",
          "summary"
        ],
        "properties": {
          "status": {
            "$ref": "#/$defs/status"
          },
          "sources": {
            "$ref": "#/$defs/sourceIds"
          },
          "note": {
            "type": "string"
          },
          "gap": {
            "type": "boolean",
            "description": "True when this row records that no related description exists."
          },
          "code": {
            "type": "string",
            "pattern": "^VC2[A-Z]{1,3}(F|[0-9]{1,2})[A-Z][0-9]{2}$"
          },
          "band": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 5,
            "description": "In our own words: what it covers and how it connects."
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 26,
            "description": "Two to four words for the box on the map, in our own words."
          }
        }
      }
    }
  }
}
