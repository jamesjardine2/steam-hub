<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
{# Page titles computed from content are already escaped once. #}
<title>{{ title | safe }} · FCPS STEAM</title>
<script src="/assets/theme.js" data-area="hub"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap">
{# Tabler icons for pedagogy tags, only on pages that show them. #}
{% if (lesson and lesson.pedagogy.length) or (unit and unit.pedagogy) %}<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css">
{% endif %}<link rel="stylesheet" href="/assets/tokens.css">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body data-repo="{{ site.repo }}" data-branch="{{ site.branch }}">
<header class="topbar">
  <nav class="wrap nav" aria-label="Main">
    <a class="brand" href="/">FCPS STEAM</a>
    <a href="/"{% if nav == "overview" %} aria-current="page"{% endif %}>Overview</a>
    <a href="/units/"{% if nav == "units" %} aria-current="page"{% endif %}>Units</a>
    <a href="/settings/"{% if nav == "settings" %} aria-current="page"{% endif %}>Settings</a>
    <button type="button" class="theme-toggle" data-theme-toggle>Light mode</button>
  </nav>
</header>
<main class="wrap page">
{{ content | safe }}
</main>
<a hidden id="progress-url" href="/progress.json"></a>
<script src="/assets/site.js"></script>
<script src="/assets/hub.js"></script>
</body>
</html>
