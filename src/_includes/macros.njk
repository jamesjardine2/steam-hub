{% macro text(value, tag="span", cls="") -%}
<{{ tag }}{% if cls or (value | isPlaceholder) %} class="{{ cls }}{% if value | isPlaceholder %} ph{% endif %}"{% endif %}>{{ value }}</{{ tag }}>
{%- endmacro %}

{% macro lisc(lisc, missing="[LISC to add from the plan]") %}
{% if lisc %}
<p class="lisc-label">Learning Intention:</p>
<p class="lisc-li">{{ lisc.intention }}</p>
<p class="lisc-label">Success Criteria:</p>
<p class="lisc-ican">I can:</p>
<ul class="lisc-sc">
  {% for c in lisc.criteria %}<li>{{ c }}</li>{% endfor %}
</ul>
<button type="button" class="btn-text" data-copy="{{ lisc.text }}">Copy LISC</button>
<span class="copy-status" role="status"></span>
{% else %}
<p class="ph">{{ missing }}</p>
{% endif %}
{% endmacro %}

{% macro chips(list) %}
<div class="chips">{% for c in list %}<span class="chip">{{ c }}</span>{% endfor %}</div>
{% endmacro %}

{# Curriculum codes as chips that open the code on the VCAA site. #}
{% macro codes(list) %}
<div class="chips">{% for c in list %}<a class="chip" href="{{ c | vc2Url }}" target="_blank" rel="noopener" title="Open {{ c }} in the Victorian Curriculum">{{ c }}</a>{% endfor %}</div>
{% endmacro %}

{% macro reflection(r, where="") %}
<div class="reflection">
  <p class="meta">{{ r.dateLabel }}{% if where %} · {{ where }}{% endif %}{% if r.className %} · {{ r.className }}{% endif %}</p>
  <div class="prose">{{ r.html | safe }}</div>
</div>
{% endmacro %}

{# One class's tick for one lesson. hub.js keeps these in step with GitHub. #}
{% macro tick(u, number, title, cls, date, dateLabel, enabled, style) %}
<button type="button" class="tick tick-{{ style }}" data-tick data-unit="{{ u.slug }}" data-unit-title="{{ u.title }}" data-lesson="{{ number }}" data-lesson-title="{{ title }}" data-class="{{ cls }}" data-date="{{ date }}" aria-pressed="{{ 'true' if date else 'false' }}" aria-label="{{ cls }} finished Lesson {{ number }}"{% if not enabled %} disabled title="Lesson {{ number }} is not planned yet"{% endif %}>
  {%- if style == "cell" -%}
  <span class="tick-mark" aria-hidden="true">{{ "✓" if date }}</span>
  {%- else -%}
  <span class="tick-name">{{ cls }}</span><span class="tick-date">{{ dateLabel or "Not yet" }}</span>
  {%- endif -%}
</button>
{% endmacro %}

{% macro progressTable(u) %}
<div class="table-scroll">
  <table class="progress">
    <thead>
      <tr>
        <th scope="col">Class</th>
        {% for s in u.slots %}<th scope="col" title="Lesson {{ s.number }}: {{ s.title }}">{% if s.lesson %}<a href="{{ s.lesson.url }}">L{{ s.number }}</a>{% else %}L{{ s.number }}{% endif %}</th>{% endfor %}
        <th scope="col" class="next-col">Up to</th>
      </tr>
    </thead>
    <tbody>
      {% for row in u.classRows %}
      <tr data-class-row>
        <th scope="row">{{ row.name }}</th>
        {% for c in row.cells %}<td>{{ tick(u, c.number, c.title, row.name, c.date, c.dateLabel, c.enabled, "cell") }}</td>{% endfor %}
        <td class="next-col" data-next>{{ row.next }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="small muted sync" data-sync-status></p>
{% endmacro %}

{% macro accordion(title, hint="", open=false) %}
<details class="acc"{% if open %} open{% endif %}>
  <summary><span class="acc-title">{{ title }}</span>{% if hint %}<span class="acc-hint">{{ hint }}</span>{% endif %}</summary>
  <div class="acc-body">{{ caller() }}</div>
</details>
{% endmacro %}

{# Pedagogy tags (src/_data/lenses.json). Teacher pages only. #}
{% macro lensSource(row) %}
{% if row.source %}
<a class="lens-link" href="{{ row.source.url }}" target="_blank" rel="noopener"><i class="ti {{ 'ti-lock' if row.source.login else 'ti-external-link' }}" aria-hidden="true"></i>{{ row.source.label }}{% if row.source.inherited %}<span class="visually-hidden"> (broader source)</span>{% endif %}</a>
{% else %}
<span class="lens-link lens-missing"><i class="ti ti-link-off" aria-hidden="true"></i>{{ row.missingLabel }}: add link</span>
{% endif %}
{% endmacro %}

{% macro lensRow(row) %}
<div class="lens-row">
  <span class="lens-tile tier-{{ row.tier }}"><i class="ti {{ row.icon }}" data-lens-icon="{{ row.id }}" aria-hidden="true"></i></span>
  <div class="lens-text">
    <div class="lens-top"><span class="lens-label">{{ row.label }}</span><span class="lens-level tier-{{ row.tier }}">{{ row.levelLabel }}</span></div>
    <p class="lens-path">{{ row.path }}</p>
    {% for h in row.howHtml %}<p class="lens-how">{{ h | safe }}</p>{% else %}<p class="lens-how ph">[How this lesson uses it: to add]</p>{% endfor %}
    <div class="lens-links">
      {{ lensSource(row) }}
      {% for f in row.further %}<a class="lens-further" href="{{ f.url }}" target="_blank" rel="noopener">{{ f.label }}</a>{% endfor %}
    </div>
  </div>
</div>
{% endmacro %}

{% macro lensGrid(unit, grid) %}
<div class="lens-grid-wrap">
<table class="lens-grid">
  <thead>
    <tr>
      <th scope="col" class="lens-grid-label"><span class="visually-hidden">Practice</span></th>
      {% for c in grid.columns %}
      <th scope="col" data-lesson-col="{{ loop.index0 }}"{% if c.url %} data-lesson-url="{{ c.url }}"{% endif %}>{% if c.url %}<a href="{{ c.url }}" title="Lesson {{ c.number }}: {{ c.title }}">L{{ c.number }}</a>{% else %}<span title="Lesson {{ c.number }} not planned yet">L{{ c.number }}</span>{% endif %}</th>
      {% endfor %}
    </tr>
  </thead>
  {% for g in grid.groups %}
  <tbody>
    <tr class="lens-tier"><th scope="rowgroup" colspan="{{ grid.columns.length + 1 }}">{{ g.label }}</th></tr>
    {% for r in g.rows %}
    <tr>
      <th scope="row" class="lens-grid-label" title="{{ r.path }}">
        {% if r.source %}<a href="{{ r.source.url }}" target="_blank" rel="noopener">{% else %}<span class="lens-missing-row">{% endif %}<i class="ti {{ r.icon }} tier-{{ r.tier }}" data-lens-icon="{{ r.id }}" aria-hidden="true"></i><span class="lens-grid-name">{{ r.label }}</span>{% if r.source %}</a>{% else %}</span>{% endif %}
      </th>
      {% for cell in r.cells %}
      <td data-lesson-col="{{ loop.index0 }}">{% if cell %}<span class="lens-dot lens-{{ cell.level }} tier-{{ r.tier }}" title="Lesson {{ grid.columns[loop.index0].number }}, {{ 'Focus' if cell.level == 'focus' else 'Present' }}: {{ cell.how or 'how to add' }}"></span><span class="visually-hidden">{{ cell.level }}</span>{% endif %}</td>
      {% endfor %}
    </tr>
    {% endfor %}
  </tbody>
  {% endfor %}
</table>
</div>
{% if grid.routines.length %}
<p class="lens-routine"><i class="ti ti-repeat" aria-hidden="true"></i>Built into every lesson: {% for r in grid.routines %}{% if r.source %}<a href="{{ r.source.url }}" target="_blank" rel="noopener">{{ r.label }}</a>{% else %}<span class="lens-missing">{{ r.label }} (add link)</span>{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</p>
{% endif %}
<div class="lens-legend">
  <span><span class="lens-dot lens-focus tier-curriculum"></span>Focus</span>
  <span><span class="lens-dot lens-present tier-curriculum"></span>Present</span>
  <span class="tier-department"><span class="lens-dot lens-focus tier-department"></span>Department</span>
  <span class="tier-adopted"><span class="lens-dot lens-focus tier-adopted"></span>School-adopted</span>
  <span class="tier-fcps"><span class="lens-dot lens-focus tier-fcps"></span>FCPS</span>
  <span class="tier-curriculum"><span class="lens-dot lens-focus tier-curriculum"></span>Curriculum</span>
</div>
{% endmacro %}
