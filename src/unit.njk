---
layout: base.njk
nav: units
pagination:
  data: site.units
  size: 1
  alias: unit
permalink: "{{ unit.url }}"
eleventyComputed:
  title: "{{ unit.title }}"
---
{% import "macros.njk" as m %}
<p class="crumbs"><a href="/">Overview</a> / {{ unit.cohortLabel }} / {{ unit.termLabel }}</p>

<section class="hero">
  <div class="hero-text">
    <p class="hero-kicker">{{ unit.cohortLabel }} · {{ unit.lessonCount }} lessons{% if unit.focus %} · {{ unit.focus }}{% endif %}</p>
    <h1>{{ unit.title }}</h1>
    {% if unit.descriptionHtml %}<div class="hero-desc">{{ unit.descriptionHtml | safe }}</div>{% endif %}
  </div>
  <div class="actions">
    <a class="btn btn-white" href="{{ unit.claudeChat or 'https://claude.ai' }}" target="_blank" rel="noopener">Next lesson in Claude</a>
  </div>
</section>

<div class="columns">
  <section class="main-col stack">
    {% if unit.classRows.length %}
    <h2 class="section-title">Where each class is up to</h2>
    {{ m.progressTable(unit) }}
    {% endif %}
    {% if unit.pedagogy %}
    <div class="accs">
      {% call m.accordion("Pedagogy at a glance", unit.pedagogy.count + (" practice" if unit.pedagogy.count == 1 else " practices")) %}
        {{ m.lensGrid(unit, unit.pedagogy) }}
      {% endcall %}
    </div>
    {% endif %}
    <h2 class="section-title">Lessons</h2>
    {% for s in unit.slots %}
    <article class="card lesson-row">
      <span class="num">{{ s.number }}</span>
      <div class="lesson-row-text">
        <h3>{{ m.text(s.title) }}</h3>
        {% if s.summary %}<p>{{ m.text(s.summary) }}</p>{% endif %}
      </div>
      <span class="status status-{{ s.state }}">{{ s.stateLabel }}</span>
      <span class="small muted extras">{{ s.extras }}</span>
      {% if s.lesson %}<a class="row-link" href="{{ s.lesson.url }}">Open<span class="visually-hidden"> Lesson {{ s.number }}</span></a>{% else %}<span class="row-link"></span>{% endif %}
    </article>
    {% endfor %}
  </section>

  <aside class="side-col stack">
    {% if unit.nextToPlan %}
    {% set nextSlot = unit.slots[unit.nextToPlan.number - 1] %}
    <div class="card stack-tight" data-plan data-unit="{{ unit.slug }}" data-lesson="{{ unit.nextToPlan.number }}">
      <h2 class="card-title">Plan the next lesson</h2>
      {% if nextSlot.lesson %}
      <p class="small">Lesson {{ nextSlot.number }}: {{ nextSlot.title }} is a draft waiting for you.</p>
      <a class="btn" href="{{ nextSlot.lesson.url }}">Review the draft</a>
      {% else %}
      <p class="small"><strong>Lesson {{ unit.nextToPlan.number }}: {{ m.text(unit.nextToPlan.title) }}</strong>{% if nextSlot.summary %}. {{ nextSlot.summary }}{% endif %}</p>
      <label class="small strong" for="plan-notes">Anything Claude should know? (optional)</label>
      <textarea id="plan-notes" rows="3" data-notes placeholder="e.g. 2B will have a CRT, keep it screen-free"></textarea>
      <button type="button" class="btn" data-start-plan>Plan Lesson {{ unit.nextToPlan.number }} with Claude</button>
      <p class="small muted">Claude writes the lesson, slides, word wall and animation. It takes about 5 to 10 minutes, then appears here as a draft for you to review.</p>
      {% endif %}
      <p class="small" data-status role="status"></p>
    </div>
    {% endif %}
    <div class="card">
      <h2 class="card-title">Unit LISC</h2>
      {{ m.lisc(unit.lisc, "[Unit LISC to add in unit.md]") }}
    </div>
    <div class="card">
      <h2 class="card-title">Curriculum</h2>
      {% if unit.curriculum.length %}{{ m.codes(unit.curriculum) }}{% else %}<p class="ph">[Curriculum codes to add]</p>{% endif %}
      {{ m.connections(unit.connections) }}
    </div>
    <div class="card stack-tight">
      <h2 class="card-title">Files and links</h2>
      {% if unit.claudeChat %}
        <a class="link-row" href="{{ unit.claudeChat }}" target="_blank" rel="noopener">Pinned chat: {{ unit.cohortLabel }} Term {{ unit.term }}</a>
      {% else %}
        <p class="ph small">[Add the pinned chat link as claude_chat in unit.md]</p>
      {% endif %}
      {% for p in unit.pdfs %}
        <a class="link-row" href="{{ p.url }}">Lesson {{ p.number }} plan (PDF)</a>
      {% endfor %}
      {% for l in unit.links %}
        <a class="link-row" href="{{ l.url }}">{{ l.label }}</a>
      {% endfor %}
    </div>
    <div class="card amber stack-tight">
      <h2 class="card-title">Unit reflection</h2>
      {% for r in unit.unitReflections %}
        {{ m.reflection(r) }}
      {% else %}
        <p class="ph small">[End-of-unit note: what to keep, cut and change when this comes round again]</p>
      {% endfor %}
      <a class="btn btn-amber" href="{{ unit.reflectionsEditUrl }}" target="_blank" rel="noopener">Add a reflection</a>
      <p class="next-taught-line">Next taught: {{ unit.nextTaught }}</p>
    </div>
  </aside>
</div>
