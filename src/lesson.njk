---
layout: base.njk
nav: units
pagination:
  data: site.lessons
  size: 1
  alias: lesson
permalink: "{{ lesson.url }}"
eleventyComputed:
  title: "Lesson {{ lesson.number }}: {{ lesson.title }}"
---
{% import "macros.njk" as m %}
{% set unit = lesson.unit %}
<p class="crumbs"><a href="/">Overview</a> / <a href="{{ unit.url }}">{{ unit.cohortLabel }}: {{ unit.title }}</a> / Lesson {{ lesson.number }}</p>

<nav class="lesson-nav" aria-label="Previous and next lesson">
  {% if lesson.prev %}<a class="btn btn-outline" href="{{ lesson.prev.url }}">&larr; Lesson {{ lesson.prev.number }}: {{ lesson.prev.title }}</a>{% else %}<span></span>{% endif %}
  {% if lesson.next %}<a class="btn btn-outline" href="{{ lesson.next.url }}">Lesson {{ lesson.next.number }}: {{ lesson.next.title }} &rarr;</a>
  {% elif lesson.number < unit.lessonCount %}<a class="btn btn-outline muted-btn" href="{{ unit.url }}">Lesson {{ lesson.number + 1 }} not planned yet</a>{% endif %}
</nav>

<section class="page-head">
  <div>
    <p class="kicker">Lesson {{ lesson.number }} of {{ unit.lessonCount }} · {{ lesson.duration }} minutes{% if lesson.status == "draft" %} · Draft{% endif %}</p>
    <h1>{{ m.text(lesson.title) }}</h1>
    {% if lesson.summary %}<p class="lede">{{ lesson.summary }}</p>{% endif %}
  </div>
  <div class="actions">
    {% if lesson.pdf %}<a class="btn btn-outline" href="{{ lesson.pdf }}">Plan PDF</a>{% endif %}
  </div>
</section>

{% if lesson.status == "draft" %}
<section class="card amber stack-tight" data-review data-path="{{ lesson.sourcePath }}" data-unit="{{ unit.slug }}" data-lesson="{{ lesson.number }}" data-lesson-title="{{ lesson.title }}">
  <h2 class="card-title">This lesson is a draft</h2>
  <p class="small">Read through it, then approve it, or tell Claude what to change.</p>
  <div class="actions">
    <button type="button" class="btn" data-approve>Approve this lesson</button>
  </div>
  <label class="small strong" for="changes">Ask for changes</label>
  <textarea id="changes" rows="3" data-notes placeholder="e.g. Make the hook shorter and use books instead of pebbles"></textarea>
  <div class="actions"><button type="button" class="btn btn-amber" data-revise>Send to Claude</button></div>
  <p class="small" data-status role="status"></p>
</section>
{% endif %}

<div class="columns">
  <section class="main-col stack">
    <div class="row-between">
      <h2 class="section-title">Lesson overview</h2>
      <button type="button" class="btn-text" data-expand-all>Expand all</button>
    </div>
    {% if lesson.introHtml %}<div class="prose note">{{ lesson.introHtml | safe }}</div>{% endif %}

    <div class="accs">
      {% call m.accordion("LISC", "Learning Intention and Success Criteria") %}
        {{ m.lisc(lesson.lisc) }}
      {% endcall %}

      {% call m.accordion("Lesson at a glance", (lesson.sequence | length) + " steps" if lesson.sequence.length else "") %}
        {% if lesson.sequence.length %}
        <div class="glance">
          {% for s in lesson.sequence %}
          <div class="glance-row">
            <span class="glance-phase">{{ s.phase }}</span>
            <span class="glance-time">{{ s.time }}</span>
            <span class="glance-what">{{ m.text(s.what) }}</span>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <p class="ph">[Sequence to add from the plan]</p>
        {% endif %}
      {% endcall %}

      {% for section in lesson.sections %}
        {% call m.accordion(section.title) %}
          <div class="prose">{{ section.html | safe }}</div>
        {% endcall %}
      {% else %}
        {% call m.accordion("Full plan") %}<p class="ph">[Full plan to add]</p>{% endcall %}
      {% endfor %}

      {% call m.accordion("Resources", (lesson.resources | length) + " items" if lesson.resources.length else "") %}
        {% if lesson.resources.length %}
        <ul class="list">{% for r in lesson.resources %}<li>{{ r }}</li>{% endfor %}</ul>
        {% else %}
        <p class="ph">[Resources to add]</p>
        {% endif %}
      {% endcall %}

      {% call m.accordion("Curriculum and approach") %}
        <div class="stack-tight">
          {% if lesson.curriculum.length %}{{ m.chips(lesson.curriculum) }}{% else %}<p class="small muted">Unit codes: {{ unit.curriculum | join(", ") }}</p>{% endif %}
          {% if lesson.vtlm.length %}<p class="small strong">VTLM 2.0</p>{{ m.chips(lesson.vtlm) }}{% endif %}
          {% if lesson.citw.length %}<p class="small strong">CITW</p>{{ m.chips(lesson.citw) }}{% endif %}
          {% if not lesson.vtlm.length and not lesson.citw.length %}<p class="ph small">[VTLM and CITW elements to add]</p>{% endif %}
        </div>
      {% endcall %}

      {% call m.accordion("Reflections", (lesson.reflections | length) + " notes" if lesson.reflections.length else "") %}
        <div class="stack">
          {% for r in lesson.reflections %}
            {{ m.reflection(r) }}
          {% else %}
            <p class="muted">No reflections for this lesson yet.</p>
          {% endfor %}
          <div>
            <a class="btn btn-outline" href="{{ unit.reflectionsEditUrl }}" target="_blank" rel="noopener">Add a reflection</a>
            <p class="small muted hint">Opens the unit's reflections file on GitHub. Start a new entry with: ## YYYY-MM-DD · Lesson {{ lesson.number }} · class</p>
          </div>
        </div>
      {% endcall %}
    </div>

    <nav class="pager" aria-label="Lessons in this unit">
      {% if lesson.prev %}<a href="{{ lesson.prev.url }}">Previous: Lesson {{ lesson.prev.number }} {{ lesson.prev.title }}</a>{% else %}<span></span>{% endif %}
      {% if lesson.next %}<a href="{{ lesson.next.url }}">Next: Lesson {{ lesson.next.number }} {{ lesson.next.title }}</a>{% endif %}
    </nav>
  </section>

  <aside class="side-col stack">
    {% if lesson.classes.length %}
    <div class="card stack-tight">
      <h2 class="card-title">Classes finished</h2>
      <p class="small muted">Tap a class when it has done this lesson.</p>
      <div class="ticks">
        {% for c in lesson.classes %}{{ m.tick(unit, lesson.number, lesson.title, c.name, c.date, c.dateLabel, true, "chip") }}{% endfor %}
      </div>
      <p class="small muted sync" data-sync-status></p>
    </div>
    {% endif %}

    <div class="card stack-tight">
      <h2 class="card-title">Bring up live</h2>
      {% for a in lesson.live %}
        {% if a.href %}
        <a class="artefact" href="{{ a.href }}" target="_blank" rel="noopener">
        {% else %}
        <div class="artefact artefact-missing">
        {% endif %}
          <span class="artefact-kind">{{ a.kind }}</span>
          <span class="artefact-text">
            <span class="artefact-title">{{ a.title }}</span>
            <span class="small muted">{% if a.href %}{{ a.note }}{% else %}{{ a.note }}{% if a.note %} · {% endif %}<span class="ph">[file to add]</span>{% endif %}</span>
          </span>
        {% if a.href %}</a>{% else %}</div>{% endif %}
      {% else %}
        <p class="muted small">No live artefacts for this lesson.</p>
      {% endfor %}
    </div>

    <div class="card amber stack-tight" data-crt data-unit="{{ unit.slug }}" data-lesson="{{ lesson.number }}">
      <h2 class="card-title">Away for this one?</h2>
      {% if lesson.crtNotes %}<p class="small">{{ lesson.crtNotes }}</p>{% endif %}
      {% if lesson.crtPdf %}
        <a class="btn btn-amber" href="{{ lesson.crtPdf }}" download="Lesson {{ lesson.number }} {{ lesson.title }} CRT plan.pdf">Download the CRT plan (PDF)</a>
        <p class="small">Need it changed? Write what is different in the box below, then press Make a new CRT plan.</p>
      {% else %}
        <p class="small">Claude writes a printable CRT plan with the same Learning Intention: no screens, everyday resources and every step explained. It takes about 5 to 10 minutes and you can leave the page.</p>
      {% endif %}
      <label class="small strong" for="crt-notes">Anything the CRT should know? (optional)</label>
      <textarea id="crt-notes" rows="2" data-notes placeholder="For example: no scissors in that room, or the class is out of flour"></textarea>
      <button type="button" class="btn {{ 'btn-outline' if lesson.crtPdf else 'btn-amber' }}" data-start-crt>{{ "Make a new CRT plan" if lesson.crtPdf else "Make a CRT plan with Claude" }}</button>
      <p class="small" data-status role="status"></p>
    </div>
  </aside>
</div>
